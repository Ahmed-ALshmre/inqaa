# Dashboard authentication
API_SECRET_KEY=change-me-local-api-secret
SESSION_SECRET_KEY=change-me-long-random-session-secret
DASHBOARD_PASSWORD=admin123
PUBLIC_URL=https://your-railway-domain.up.railway.app
STORE_NAME=لمسة ستور
TELEGRAM_NOTIFICATION_HEADER=لمسة ستور

# OpenRouter / AI models
OPENROUTER_API_KEY=
MAIN_MODEL=google/gemini-3-flash-preview
IMPROVE_MODEL=google/gemini-3-flash-preview
CHECKER_MODEL=google/gemini-3.1-pro-preview
VISION_MODEL=google/gemini-3.1-pro-preview
CATALOG_MATCH_MODEL=google/gemini-2.5-flash
CATALOG_MATCH_ENABLED=1
CHECKER_ENABLED=0
VISION_ENABLED=1

# Chatwoot (default messaging provider)
MESSAGING_PROVIDER=chatwoot
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
# Map account:inbox to an existing store ID, e.g. {"1:2":"default"}
CHATWOOT_INBOX_STORES={}

# Legacy ManyChat (only used with MESSAGING_PROVIDER=manychat)
MANYCHAT_API_KEY=
# مفتاح مستقل لكل حساب ManyChat. النظام يختاره تلقائياً حسب متجر المحادثة.
MANYCHAT_API_KEY_LAMSA=
MANYCHAT_API_KEY_KHUYOOT=
MANYCHAT_API_KEY_GOLDEN_THREADS=
# اختياري للتوافق القديم: {"FACEBOOK_PAGE_ID":"API_KEY"}
MANYCHAT_KEYS_BY_PAGE=
MANYCHAT_MESSAGE_TAG=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ORDERS_CHAT_ID=

# App behavior
HUMAN_REPLY_WEBHOOK_URL=
HUMAN_REVIEW_ALL_IMAGES=1
DISABLE_CLIP=1
ASYNC_WEBHOOK=1
DEBOUNCE_DELAY=35
CATALOG_IMAGE_PATH=Gemini_Generated_Image_efqo6zefqo6zefqo.png
INCOMING_REQUESTS_FILE=incoming_requests.jsonl

# Persistent runtime data. Railway fills RAILWAY_VOLUME_MOUNT_PATH automatically
# when a Volume is attached; DATA_DIR is only needed for a custom location.
DATA_DIR=
